<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Numbers 6–10 🌟</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;900&family=Baloo+2:wght@700;900&display=swap" rel="stylesheet">
<style>
  :root {
    --c1:#FF6B6B; --c2:#FFD93D; --c3:#6BCB77; --c4:#4D96FF; --c5:#C77DFF;
    --c6:#FF9A3C; --c7:#00C9A7; --c8:#FF6FA8; --c9:#5C7CFA; --c10:#F76707;
    --bg:#F0F4FF; --radius:24px; --shadow:0 8px 32px rgba(0,0,0,.10);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:'Nunito',sans-serif;background:var(--bg);min-height:100vh;padding:0 0 60px;}

  /* HERO */
  .hero{background:linear-gradient(135deg,#5C7CFA 0%,#00C9A7 40%,#FF9A3C 70%,#FF6FA8 100%);
    text-align:center;padding:40px 20px 56px;clip-path:ellipse(100% 100% at 50% 0%);margin-bottom:-16px;}
  .hero h1{font-family:'Baloo 2',cursive;font-size:clamp(2.2rem,6vw,4rem);color:#fff;
    text-shadow:0 4px 16px rgba(0,0,0,.18);letter-spacing:2px;}
  .hero p{color:rgba(255,255,255,.92);font-size:1.2rem;margin-top:6px;}

  /* CARD */
  .card{background:#fff;border-radius:var(--radius);box-shadow:var(--shadow);
    max-width:740px;margin:32px auto 0;padding:32px 28px;position:relative;overflow:hidden;}
  .card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:8px;
    border-radius:var(--radius) 0 0 var(--radius);}
  .card:nth-child(1)::before{background:var(--c9);}
  .card:nth-child(2)::before{background:var(--c2);}
  .card:nth-child(3)::before{background:var(--c3);}
  .card:nth-child(4)::before{background:var(--c4);}
  .card:nth-child(5)::before{background:var(--c5);}
  .card:nth-child(6)::before{background:var(--c6);}

  .badge{display:inline-flex;align-items:center;gap:8px;font-family:'Baloo 2',cursive;
    font-size:.85rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;
    border-radius:99px;padding:4px 16px;margin-bottom:10px;color:#fff;}
  .card:nth-child(1) .badge{background:var(--c9);}
  .card:nth-child(2) .badge{background:var(--c2);color:#555;}
  .card:nth-child(3) .badge{background:var(--c3);}
  .card:nth-child(4) .badge{background:var(--c4);}
  .card:nth-child(5) .badge{background:var(--c5);}
  .card:nth-child(6) .badge{background:var(--c6);}

  .card h2{font-family:'Baloo 2',cursive;font-size:1.7rem;margin-bottom:6px;color:#222;}
  .card .desc{color:#666;font-size:1rem;margin-bottom:20px;line-height:1.5;}

  /* ── EX 1: LISTEN & REPEAT ── */
  .section-label{font-weight:700;font-size:.8rem;letter-spacing:2px;text-transform:uppercase;
    color:#bbb;text-align:center;margin:8px 0 12px;}
  .num-grid{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin-bottom:6px;}
  .num-btn{width:88px;height:88px;border-radius:20px;border:none;font-family:'Baloo 2',cursive;
    font-size:2.6rem;font-weight:900;cursor:pointer;display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:2px;transition:transform .15s,box-shadow .15s;
    box-shadow:0 6px 0 rgba(0,0,0,.13);color:#fff;}
  .num-btn span.word{font-size:.72rem;font-family:'Nunito',sans-serif;font-weight:700;
    letter-spacing:1px;opacity:.92;}
  .num-btn:active{transform:translateY(3px);box-shadow:0 3px 0 rgba(0,0,0,.13);}
  .num-btn:hover{transform:scale(1.1) rotate(-2deg);}
  .nb1{background:var(--c1);} .nb2{background:var(--c2);color:#333;} .nb3{background:var(--c3);}
  .nb4{background:var(--c4);} .nb5{background:var(--c5);}
  .nb6{background:var(--c6);} .nb7{background:var(--c7);} .nb8{background:var(--c8);}
  .nb9{background:var(--c9);} .nb10{background:var(--c10);}
  .divider{border:none;border-top:2px dashed #e8e8f0;margin:20px 0;}
  .speak-tip{text-align:center;color:#bbb;font-size:.85rem;margin-top:8px;}

  /* ── EX 2: MATCHING ── */
  .match-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px 20px;}
  .match-col-header{font-weight:700;font-size:.82rem;letter-spacing:1px;text-transform:uppercase;
    color:#aaa;text-align:center;margin-bottom:4px;}
  .match-item{border:3px solid #eee;border-radius:14px;padding:11px 14px;text-align:center;
    font-family:'Baloo 2',cursive;font-size:1.35rem;cursor:pointer;transition:all .2s;
    user-select:none;background:#fafafa;}
  .match-item:hover{border-color:#4D96FF;background:#eef5ff;transform:scale(1.04);}
  .match-item.selected{border-color:#4D96FF;background:#dceeff;}
  .match-item.matched{border-color:#6BCB77;background:#e6f9ea;color:#2a7a3b;pointer-events:none;}
  .match-item.wrong{border-color:#FF6B6B;background:#ffe8e8;animation:shake .3s;}
  @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
  .match-result{text-align:center;margin-top:12px;font-weight:700;font-size:1.1rem;color:#6BCB77;min-height:28px;}

  /* ── EX 3: JUMP & COUNT ── */
  .action-cards{display:flex;flex-direction:column;gap:12px;}
  .action-card{display:flex;align-items:center;gap:14px;background:#f8f8ff;border-radius:16px;
    padding:14px 18px;border:2px solid #e8e8f8;transition:all .2s;cursor:pointer;user-select:none;}
  .action-card:hover{border-color:var(--c5);background:#f3eeff;transform:translateX(4px);}
  .action-card.done{border-color:var(--c3);background:#e8faed;}
  .action-icon{font-size:2.1rem;width:46px;text-align:center;flex-shrink:0;}
  .action-text{font-family:'Baloo 2',cursive;font-size:1.3rem;color:#333;flex:1;}
  .action-check{font-size:1.8rem;opacity:0;transition:opacity .2s;}
  .action-card.done .action-check{opacity:1;}
  .action-audio{background:none;border:none;font-size:1.4rem;cursor:pointer;
    padding:4px 6px;border-radius:8px;transition:transform .15s;flex-shrink:0;}
  .action-audio:hover{transform:scale(1.2);}

  /* ── EX 4: MISSING NUMBER ── */
  .missing-row{display:flex;align-items:center;justify-content:center;gap:10px;
    flex-wrap:wrap;margin-bottom:18px;}
  .mnum{width:68px;height:68px;border-radius:14px;display:flex;align-items:center;
    justify-content:center;font-family:'Baloo 2',cursive;font-size:2.1rem;font-weight:900;
    color:#fff;box-shadow:0 5px 0 rgba(0,0,0,.12);}
  .mnum.blank{background:#f0f0f0;border:3px dashed #ccc;color:#ccc;font-size:1.9rem;box-shadow:none;}
  .mnum.filled{animation:popIn .35s cubic-bezier(.17,.89,.32,1.28);}
  @keyframes popIn{0%{transform:scale(.5)}100%{transform:scale(1)}}
  .mn6{background:var(--c6);} .mn7{background:var(--c7);} .mn8{background:var(--c8);}
  .mn9{background:var(--c9);} .mn10{background:var(--c10);}
  .answer-btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:8px;}
  .ans-btn{width:58px;height:58px;border-radius:14px;border:none;font-family:'Baloo 2',cursive;
    font-size:1.6rem;cursor:pointer;background:#f0f0f0;color:#555;transition:all .15s;
    box-shadow:0 4px 0 rgba(0,0,0,.1);}
  .ans-btn:hover{background:#ffe8a0;transform:scale(1.1);}
  .ans-btn:active{transform:translateY(2px);box-shadow:0 2px 0 rgba(0,0,0,.1);}
  .missing-feedback{text-align:center;font-size:1.4rem;font-weight:700;min-height:36px;}
  .missing-nav{display:flex;justify-content:center;gap:10px;margin-top:14px;}
  .nav-btn{padding:8px 24px;border-radius:99px;border:none;background:#4D96FF;color:#fff;
    font-family:'Nunito',sans-serif;font-weight:700;font-size:1rem;cursor:pointer;transition:all .15s;}
  .nav-btn:hover{background:#2a7ae6;transform:scale(1.05);}
  .nav-btn.secondary{background:#eee;color:#555;}
  .nav-btn.secondary:hover{background:#ddd;}

  /* ── EX 5: NUMBER HUNT ── */
  .hunt-task{background:linear-gradient(135deg,#FFF3CD,#fff);border-radius:18px;padding:18px 22px;
    margin-bottom:16px;border:2px solid #FFD93D;display:none;}
  .hunt-task.active{display:block;animation:fadeSlide .4s ease;}
  @keyframes fadeSlide{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
  .hunt-task .task-text{font-family:'Baloo 2',cursive;font-size:1.5rem;color:#444;margin-bottom:10px;}
  .hunt-task .task-icon{font-size:2.2rem;margin-bottom:6px;}
  .hunt-counter-row{display:flex;align-items:center;gap:14px;margin-top:8px;flex-wrap:wrap;}
  .hunt-count-display{font-family:'Baloo 2',cursive;font-size:2.1rem;color:var(--c4);min-width:52px;}
  .hunt-tap-btn{padding:10px 20px;border-radius:99px;background:var(--c4);color:#fff;border:none;
    font-family:'Nunito',sans-serif;font-weight:700;font-size:1rem;cursor:pointer;transition:all .15s;}
  .hunt-tap-btn:hover{filter:brightness(1.1);transform:scale(1.05);}
  .hunt-done-btn{padding:10px 20px;border-radius:99px;background:var(--c3);color:#fff;border:none;
    font-family:'Nunito',sans-serif;font-weight:700;font-size:1rem;cursor:pointer;transition:all .15s;
    margin-left:auto;}
  .hunt-done-btn:hover{filter:brightness(1.1);}
  .hunt-speak-btn{padding:10px 14px;border-radius:99px;background:#f0f0f8;border:none;font-size:1.3rem;
    cursor:pointer;transition:transform .15s;}
  .hunt-speak-btn:hover{transform:scale(1.15);}
  .hunt-progress{display:flex;gap:8px;justify-content:center;margin-bottom:14px;}
  .hunt-dot{width:12px;height:12px;border-radius:50%;background:#e0e0e0;transition:background .3s;}
  .hunt-dot.done{background:var(--c3);}
  .hunt-dot.active{background:var(--c4);}
  .hunt-feedback{text-align:center;font-size:1.25rem;font-weight:700;min-height:30px;color:var(--c3);}

  /* ── EX 6: COUNT OBJECTS ── */
  .count-stage{text-align:center;}
  .emoji-display{font-size:2.5rem;letter-spacing:4px;margin:16px 0;min-height:60px;animation:popIn .4s ease;}
  .count-question-row{display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:16px;}
  .count-question{font-family:'Baloo 2',cursive;font-size:1.4rem;color:#444;}
  .count-q-speak{background:none;border:none;font-size:1.3rem;cursor:pointer;transition:transform .15s;}
  .count-q-speak:hover{transform:scale(1.2);}
  .count-choices{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:12px;}
  .count-choice{width:66px;height:66px;border-radius:16px;border:3px solid #eee;background:#fafafa;
    font-family:'Baloo 2',cursive;font-size:1.9rem;cursor:pointer;transition:all .2s;}
  .count-choice:hover{border-color:var(--c4);background:#eef5ff;transform:scale(1.1);}
  .count-choice.correct{border-color:var(--c3);background:#e4faeb;animation:popIn .3s;}
  .count-choice.wrong{border-color:var(--c1);background:#ffe8e8;animation:shake .3s;}
  .count-feedback{font-size:1.35rem;font-weight:700;min-height:34px;margin-bottom:8px;}
  .count-score{font-size:1rem;color:#aaa;margin-bottom:12px;}
  .count-next{padding:10px 32px;border-radius:99px;background:var(--c3);color:#fff;border:none;
    font-family:'Nunito',sans-serif;font-weight:700;font-size:1rem;cursor:pointer;display:none;}
  .count-next:hover{filter:brightness(1.1);}

  /* STAR BURST */
  .celebrate{position:fixed;pointer-events:none;top:0;left:0;width:100%;height:100%;z-index:9999;display:none;}
  .star-particle{position:absolute;font-size:1.8rem;animation:starFall 1.2s ease-out forwards;}
  @keyframes starFall{0%{opacity:1;transform:translateY(0) rotate(0)}100%{opacity:0;transform:translateY(120px) rotate(360deg)}}

  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-track{background:#edf0f8;}
  ::-webkit-scrollbar-thumb{background:#5C7CFA;border-radius:4px;}
</style>
</head>
<body>

<div class="hero">
  <h1>🔢 Numbers 6–10 🌟</h1>
  <p>Let's learn bigger numbers!</p>
</div>

<div style="max-width:740px;margin:0 auto;padding:0 16px;">

<!-- ══════════════════════════════════
     EXERCISE 1: LISTEN & REPEAT
══════════════════════════════════ -->
<div class="card">
  <div class="badge">🎧 Exercise 1</div>
  <h2>Listen & Repeat</h2>
  <p class="desc">Tap each number to hear it, then say it out loud! First let's review 1–5, then learn 6–10! 🗣️</p>

  <div class="section-label">Review: 1 – 5</div>
  <div class="num-grid">
    <button class="num-btn nb1" onclick="speakNum('one',this)">1<span class="word">ONE</span></button>
    <button class="num-btn nb2" onclick="speakNum('two',this)">2<span class="word">TWO</span></button>
    <button class="num-btn nb3" onclick="speakNum('three',this)">3<span class="word">THREE</span></button>
    <button class="num-btn nb4" onclick="speakNum('four',this)">4<span class="word">FOUR</span></button>
    <button class="num-btn nb5" onclick="speakNum('five',this)">5<span class="word">FIVE</span></button>
  </div>

  <hr class="divider">
  <div class="section-label">New: 6 – 10</div>
  <div class="num-grid">
    <button class="num-btn nb6" onclick="speakNum('six',this)">6<span class="word">SIX</span></button>
    <button class="num-btn nb7" onclick="speakNum('seven',this)">7<span class="word">SEVEN</span></button>
    <button class="num-btn nb8" onclick="speakNum('eight',this)">8<span class="word">EIGHT</span></button>
    <button class="num-btn nb9" onclick="speakNum('nine',this)">9<span class="word">NINE</span></button>
    <button class="num-btn nb10" onclick="speakNum('ten',this)" style="font-size:2rem;">10<span class="word">TEN</span></button>
  </div>
  <p class="speak-tip">🔊 Tap a number and repeat after the voice!</p>
</div>

<!-- ══════════════════════════════════
     EXERCISE 2: MATCHING
══════════════════════════════════ -->
<div class="card">
  <div class="badge">🔗 Exercise 2</div>
  <h2>Matching</h2>
  <p class="desc">Match the number to the correct word. Tap a number, then tap its word! 🎯</p>
  <div class="match-grid">
    <div>
      <div class="match-col-header">Number</div>
      <div class="match-item" data-type="num" data-val="6" onclick="matchTap(this)">6</div>
      <div class="match-item" style="margin-top:9px" data-type="num" data-val="8" onclick="matchTap(this)">8</div>
      <div class="match-item" style="margin-top:9px" data-type="num" data-val="10" onclick="matchTap(this)">10</div>
      <div class="match-item" style="margin-top:9px" data-type="num" data-val="7" onclick="matchTap(this)">7</div>
      <div class="match-item" style="margin-top:9px" data-type="num" data-val="9" onclick="matchTap(this)">9</div>
    </div>
    <div>
      <div class="match-col-header">Word</div>
      <div class="match-item" data-type="word" data-val="8" onclick="matchTap(this)">Eight</div>
      <div class="match-item" style="margin-top:9px" data-type="word" data-val="6" onclick="matchTap(this)">Six</div>
      <div class="match-item" style="margin-top:9px" data-type="word" data-val="9" onclick="matchTap(this)">Nine</div>
      <div class="match-item" style="margin-top:9px" data-type="word" data-val="10" onclick="matchTap(this)">Ten</div>
      <div class="match-item" style="margin-top:9px" data-type="word" data-val="7" onclick="matchTap(this)">Seven</div>
    </div>
  </div>
  <div class="match-result" id="matchResult"></div>
</div>

<!-- ══════════════════════════════════
     EXERCISE 3: JUMP AND COUNT
══════════════════════════════════ -->
<div class="card">
  <div class="badge">🏃 Exercise 3</div>
  <h2>Jump & Count!</h2>
  <p class="desc">Listen to the command, do it, then tap ✅ when done! 💪</p>
  <div class="action-cards">
    <div class="action-card" onclick="toggleDone(this)">
      <div class="action-icon">🦘</div>
      <div class="action-text">Jump <strong>6</strong> times!</div>
      <button class="action-audio" onclick="event.stopPropagation();playTTS('Jump 6 times!')">🔊</button>
      <div class="action-check">✅</div>
    </div>
    <div class="action-card" onclick="toggleDone(this)">
      <div class="action-icon">👏</div>
      <div class="action-text">Clap <strong>8</strong> times!</div>
      <button class="action-audio" onclick="event.stopPropagation();playTTS('Clap 8 times!')">🔊</button>
      <div class="action-check">✅</div>
    </div>
    <div class="action-card" onclick="toggleDone(this)">
      <div class="action-icon">🔄</div>
      <div class="action-text">Turn around <strong>7</strong> times!</div>
      <button class="action-audio" onclick="event.stopPropagation();playTTS('Turn around 7 times!')">🔊</button>
      <div class="action-check">✅</div>
    </div>
    <div class="action-card" onclick="toggleDone(this)">
      <div class="action-icon">🦶</div>
      <div class="action-text">Stomp <strong>10</strong> times!</div>
      <button class="action-audio" onclick="event.stopPropagation();playTTS('Stomp 10 times!')">🔊</button>
      <div class="action-check">✅</div>
    </div>
    <div class="action-card" onclick="toggleDone(this)">
      <div class="action-icon">🙌</div>
      <div class="action-text">Wave your hands <strong>9</strong> times!</div>
      <button class="action-audio" onclick="event.stopPropagation();playTTS('Wave your hands 9 times!')">🔊</button>
      <div class="action-check">✅</div>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════
     EXERCISE 4: MISSING NUMBER
══════════════════════════════════ -->
<div class="card">
  <div class="badge">❓ Exercise 4</div>
  <h2>Missing Number!</h2>
  <p class="desc">Which number is missing? Tap the right answer! 🕵️</p>
  <div class="missing-row" id="missingRow"></div>
  <div class="answer-btns" id="answerBtns"></div>
  <div class="missing-feedback" id="missingFeedback"></div>
  <div class="missing-nav">
    <button class="nav-btn secondary" onclick="prevMissing()">← Back</button>
    <span id="missingProgress" style="font-weight:700;color:#aaa;align-self:center;"></span>
    <button class="nav-btn" onclick="nextMissing()">Next →</button>
  </div>
</div>

<!-- ══════════════════════════════════
     EXERCISE 5: NUMBER HUNT
══════════════════════════════════ -->
<div class="card">
  <div class="badge">🔍 Exercise 5</div>
  <h2>Number Hunt!</h2>
  <p class="desc">Listen to the task, find the objects and count them! Tap ✔ when done! 🏠</p>
  <div class="hunt-progress" id="huntProgress"></div>
  <div id="huntTaskArea"></div>
  <div class="hunt-feedback" id="huntFeedback"></div>
</div>

<!-- ══════════════════════════════════
     EXERCISE 6: COUNT OBJECTS
══════════════════════════════════ -->
<div class="card">
  <div class="badge">🍎 Exercise 6</div>
  <h2>Count Objects!</h2>
  <p class="desc">Look at the pictures and count! How many do you see? 👀</p>
  <div class="count-stage">
    <div class="count-score" id="countScore">Score: 0 / 0</div>
    <div class="emoji-display" id="emojiDisplay"></div>
    <div class="count-question-row">
      <div class="count-question" id="countQuestion"></div>
      <button class="count-q-speak" id="countQSpeak" onclick="replayCountQ()">🔊</button>
    </div>
    <div class="count-choices" id="countChoices"></div>
    <div class="count-feedback" id="countFeedback"></div>
    <button class="count-next" id="countNext" onclick="nextCountQ()">Next ➡️</button>
  </div>
</div>

</div>
<div class="celebrate" id="celebrate"></div>

<script>
/* ══════════════════════════════
   AUDIO — Google TTS (British en-GB)
══════════════════════════════ */
let currentAudio = null;
function playTTS(text, onEnd) {
  if (currentAudio) { currentAudio.pause(); currentAudio = null; }
  const url = 'https://translate.google.com/translate_tts?ie=UTF-8&tl=en-GB&client=tw-ob&q=' + encodeURIComponent(text);
  const audio = new Audio(url);
  currentAudio = audio;
  if (onEnd) audio.addEventListener('ended', onEnd, {once:true});
  audio.play().catch(() => {
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(text);
      u.lang = 'en-GB'; u.rate = 0.82; u.pitch = 1.05;
      if (onEnd) u.onend = onEnd;
      window.speechSynthesis.speak(u);
    }
  });
}

/* ══════════════════════════════
   EX 1 — SPEAK NUMBER
══════════════════════════════ */
function speakNum(word, btn) {
  btn.style.transform = 'scale(1.18) rotate(-3deg)';
  setTimeout(() => btn.style.transform = '', 380);
  playTTS(word);
}

/* ══════════════════════════════
   EX 2 — MATCHING
══════════════════════════════ */
let matchSelected = null, matchScore = 0, matchTotal = 5;
function matchTap(el) {
  if (el.classList.contains('matched')) return;
  if (!matchSelected) {
    if (matchSelected) matchSelected.classList.remove('selected');
    el.classList.add('selected');
    matchSelected = el;
    if (el.dataset.type === 'word') playTTS(el.textContent.trim());
    else playTTS(numWords[parseInt(el.textContent.trim())]);
  } else {
    if (el === matchSelected) { el.classList.remove('selected'); matchSelected = null; return; }
    if (el.dataset.type === matchSelected.dataset.type) {
      matchSelected.classList.remove('selected');
      matchSelected = el; el.classList.add('selected');
      if (el.dataset.type === 'word') playTTS(el.textContent.trim());
      else playTTS(numWords[parseInt(el.textContent.trim())]);
      return;
    }
    const fb = document.getElementById('matchResult');
    if (el.dataset.val === matchSelected.dataset.val) {
      el.classList.remove('selected'); el.classList.add('matched');
      matchSelected.classList.remove('selected'); matchSelected.classList.add('matched');
      matchScore++;
      celebrate(false);
      fb.textContent = matchScore === matchTotal ? '🎉 Perfect! All matched!' : `✅ Great! ${matchTotal - matchScore} left!`;
    } else {
      el.classList.add('wrong'); matchSelected.classList.add('wrong');
      const a = el, b = matchSelected;
      setTimeout(() => { a.classList.remove('wrong','selected'); b.classList.remove('wrong','selected'); }, 500);
      fb.textContent = '❌ Try again!';
    }
    matchSelected = null;
  }
}

/* ══════════════════════════════
   EX 3 — TOGGLE DONE
══════════════════════════════ */
function toggleDone(el) { el.classList.toggle('done'); }

/* ══════════════════════════════
   EX 4 — MISSING NUMBER
══════════════════════════════ */
const numWords = ['','one','two','three','four','five','six','seven','eight','nine','ten'];
const numColors = {6:'mn6',7:'mn7',8:'mn8',9:'mn9',10:'mn10'};
const missingPuzzles = [
  { seq:[6,7,null,9,10], answer:8 },
  { seq:[null,7,8,9,10], answer:6 },
  { seq:[6,7,8,9,null],  answer:10 },
  { seq:[6,null,8,9,10], answer:7 },
  { seq:[6,7,8,null,10], answer:9 },
];
let mIdx = 0, mAnswered = false;

function mnClass(n) {
  const map = {6:'mn6',7:'mn7',8:'mn8',9:'mn9',10:'mn10'};
  return map[n] || 'mn6';
}

function renderMissing() {
  const p = missingPuzzles[mIdx];
  mAnswered = false;
  document.getElementById('missingFeedback').textContent = '';
  document.getElementById('missingRow').innerHTML = p.seq.map(n =>
    n === null
      ? `<div class="mnum blank" id="blankBox">?</div>`
      : `<div class="mnum ${mnClass(n)}">${n}</div>`
  ).join('');
  const choices = [6,7,8,9,10].sort(() => Math.random()-.5);
  document.getElementById('answerBtns').innerHTML = choices.map(c =>
    `<button class="ans-btn" onclick="checkMissing(${c},this)">${c}</button>`
  ).join('');
  document.getElementById('missingProgress').textContent = `${mIdx+1} / ${missingPuzzles.length}`;
}

function checkMissing(val, btn) {
  if (mAnswered) return;
  const p = missingPuzzles[mIdx];
  const fb = document.getElementById('missingFeedback');
  const blank = document.getElementById('blankBox');
  if (val === p.answer) {
    mAnswered = true;
    blank.textContent = val;
    blank.className = `mnum ${mnClass(val)} filled`;
    fb.textContent = `🎉 Yes! It's ${numWords[val]}!`;
    fb.style.color = '#6BCB77';
    playTTS(numWords[val]);
    celebrate(false);
  } else {
    btn.classList.add('wrong');
    setTimeout(() => btn.classList.remove('wrong'), 400);
    fb.textContent = '❌ Try again!';
    fb.style.color = '#FF6B6B';
  }
}

function nextMissing() { if (mIdx < missingPuzzles.length-1) { mIdx++; renderMissing(); } }
function prevMissing() { if (mIdx > 0) { mIdx--; renderMissing(); } }

/* ══════════════════════════════
   EX 5 — NUMBER HUNT
══════════════════════════════ */
const huntTasks = [
  { icon:'🖊️', text:'Bring me <strong>7</strong> pens!',      spoken:'Bring me 7 pens!',     num:7 },
  { icon:'📚', text:'Find <strong>10</strong> books!',         spoken:'Find 10 books!',        num:10 },
  { icon:'🧩', text:'Bring <strong>6</strong> puzzle pieces!', spoken:'Bring me 6 puzzle pieces!', num:6 },
  { icon:'🪀', text:'Find <strong>8</strong> small toys!',     spoken:'Find 8 small toys!',   num:8 },
  { icon:'🍬', text:'Bring <strong>9</strong> sweets!',        spoken:'Bring me 9 sweets!',   num:9 },
];
let hIdx = 0, hCount = 0, hDone = [];

function renderHunt() {
  document.getElementById('huntProgress').innerHTML = huntTasks.map((t,i) =>
    `<div class="hunt-dot ${hDone.includes(i)?'done':i===hIdx?'active':''}"></div>`
  ).join('');
  const t = huntTasks[hIdx];
  hCount = 0;
  document.getElementById('huntFeedback').textContent = '';
  document.getElementById('huntTaskArea').innerHTML = `
    <div class="hunt-task active">
      <div class="task-icon">${t.icon}</div>
      <div class="task-text">${t.text}</div>
      <div class="hunt-counter-row">
        <div>
          <div style="font-size:.83rem;color:#888;margin-bottom:2px">Counted:</div>
          <div class="hunt-count-display" id="hCountDisplay">0 / ${t.num}</div>
        </div>
        <button class="hunt-tap-btn" onclick="huntTap()">+1 Found!</button>
        <button class="hunt-speak-btn" onclick="playTTS('${t.spoken}')">🔊</button>
        <button class="hunt-done-btn" onclick="huntFinish()">✔ Done!</button>
      </div>
    </div>`;
  playTTS(t.spoken);
}

function huntTap() {
  const t = huntTasks[hIdx];
  if (hCount < t.num) {
    hCount++;
    document.getElementById('hCountDisplay').textContent = `${hCount} / ${t.num}`;
    if (hCount === t.num) {
      document.getElementById('huntFeedback').textContent = `🎉 You found all ${t.num}! Tap Done!`;
    }
  }
}

function huntFinish() {
  const t = huntTasks[hIdx];
  const fb = document.getElementById('huntFeedback');
  if (hCount < t.num) {
    fb.textContent = `You need ${t.num - hCount} more! Keep looking! 🔍`;
    fb.style.color = '#FF6B6B'; return;
  }
  fb.style.color = '#6BCB77';
  hDone.push(hIdx); celebrate(false);
  if (hIdx < huntTasks.length-1) {
    setTimeout(() => { hIdx++; renderHunt(); }, 900);
  } else {
    setTimeout(() => {
      document.getElementById('huntTaskArea').innerHTML =
        `<div style="text-align:center;font-size:2rem;padding:20px">🏆 Amazing! All tasks done!</div>`;
      celebrate();
    }, 600);
  }
}

/* ══════════════════════════════
   EX 6 — COUNT OBJECTS
══════════════════════════════ */
const countQs = [
  { emoji:'🚗', count:6,  label:'cars' },
  { emoji:'🌟', count:9,  label:'stars' },
  { emoji:'🍌', count:7,  label:'bananas' },
  { emoji:'🐠', count:10, label:'fish' },
  { emoji:'🌈', count:8,  label:'rainbows' },
  { emoji:'🎈', count:6,  label:'balloons' },
  { emoji:'🍕', count:7,  label:'pizza slices' },
  { emoji:'🐝', count:9,  label:'bees' },
];
let cIdx = 0, cScore = 0, cAnswered = false;
let currentCountText = '';

function replayCountQ() { if (currentCountText) playTTS(currentCountText); }

function renderCountQ() {
  const q = countQs[cIdx];
  document.getElementById('emojiDisplay').textContent = q.emoji.repeat(q.count);
  currentCountText = `How many ${q.label}?`;
  document.getElementById('countQuestion').textContent = currentCountText;
  document.getElementById('countFeedback').textContent = '';
  document.getElementById('countNext').style.display = 'none';
  document.getElementById('countScore').textContent = `Score: ${cScore} / ${cIdx}`;
  cAnswered = false;
  // choices: correct + 3 distractors from 6–10
  const pool = [6,7,8,9,10].filter(x => x !== q.count);
  const distractors = pool.sort(() => Math.random()-.5).slice(0,3);
  const choices = [q.count, ...distractors].sort(() => Math.random()-.5);
  document.getElementById('countChoices').innerHTML = choices.map(c =>
    `<button class="count-choice" onclick="checkCount(${c},this)">${c}</button>`
  ).join('');
  playTTS(currentCountText);
}

function checkCount(val, btn) {
  if (cAnswered) return;
  cAnswered = true;
  const q = countQs[cIdx];
  const fb = document.getElementById('countFeedback');
  if (val === q.count) {
    btn.classList.add('correct');
    fb.textContent = `🌟 Yes! ${q.count} ${q.label}!`;
    fb.style.color = '#6BCB77';
    cScore++;
    celebrate(false);
    playTTS(`${numWords[q.count]}! ${q.count} ${q.label}!`);
  } else {
    btn.classList.add('wrong');
    document.querySelectorAll('.count-choice').forEach(b => {
      if (parseInt(b.textContent) === q.count) b.classList.add('correct');
    });
    fb.textContent = `❌ It's ${numWords[q.count]}! Try next time!`;
    fb.style.color = '#FF6B6B';
    playTTS(`The answer is ${numWords[q.count]}.`);
  }
  document.getElementById('countScore').textContent = `Score: ${cScore} / ${cIdx+1}`;
  document.getElementById('countNext').style.display = 'inline-block';
}

function nextCountQ() {
  cIdx = (cIdx+1) % countQs.length;
  renderCountQ();
}

/* ══════════════════════════════
   CELEBRATION
══════════════════════════════ */
function celebrate(big = true) {
  const o = document.getElementById('celebrate');
  o.innerHTML = ''; o.style.display = 'block';
  const items = big ? ['⭐','🌟','🎉','✨','🎊','💫','🏆','🎈'] : ['⭐','✨','🎉'];
  const count = big ? 32 : 10;
  for (let i = 0; i < count; i++) {
    const el = document.createElement('div');
    el.className = 'star-particle';
    el.style.left = Math.random()*100 + 'vw';
    el.style.top = (Math.random()*60+5) + 'vh';
    el.style.animationDelay = (Math.random()*.6) + 's';
    el.style.fontSize = (1.2 + Math.random()*1.5) + 'rem';
    el.textContent = items[Math.floor(Math.random()*items.length)];
    o.appendChild(el);
  }
  setTimeout(() => o.style.display = 'none', 2000);
}

/* INIT */
renderMissing();
renderHunt();
renderCountQ();
</script>
